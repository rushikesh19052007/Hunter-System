rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HUNTR SECURITY RULES (Least Privilege Architecture)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUsername(uname) {
      return uname.matches('^[a-z0-9_]{3,20}$');
    }

    function isGuildLeader(guildId) {
      return isAuthenticated() && guildId != null &&
        get(/databases/$(database)/documents/guilds/$(guildId)).data.leaderUid == request.auth.uid;
    }

    // Guild update permitted for owner OR guild leader of target guild on specific guild affiliation fields
    function isGuildAffiliationUpdateOnly(userId) {
      return isAuthenticated() &&
        (isOwner(userId) ||
         (request.resource.data.guildId != null && isGuildLeader(request.resource.data.guildId)) ||
         (resource.data.guildId != null && isGuildLeader(resource.data.guildId)) ||
         (request.resource.data.guild_id != null && isGuildLeader(request.resource.data.guild_id)) ||
         (resource.data.guild_id != null && isGuildLeader(resource.data.guild_id))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guildId', 'guildRole', 'guildName', 'guildTag',
          'guild_id', 'guild_role', 'guild_name', 'guild_tag',
          'updatedAt'
        ]);
    }

    // ===============================================================
    // 1. Usernames Registry
    // ===============================================================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username &&
        isValidUsername(username);
      allow update: if false; // Permanent and immutable
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 2. Permanent Unique Hunter IDs
    // ===============================================================
    match /hunterIds/{hunterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // Permanent and immutable
    }

    // ===============================================================
    // 3. Public Player Profiles (Searchable directory, sanitized data only)
    // ===============================================================
    match /players/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Owner can update, or guild affiliation sync when joining/leaving
      allow update: if isOwner(userId) || isGuildAffiliationUpdateOnly(userId);
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // 4. Private Hunter Profiles, Quests, Stats & Achievements
    // ===============================================================
    match /hunters/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isGuildAffiliationUpdateOnly(userId);
      allow delete: if isOwner(userId);

      // Friends Subcollection (Mutual friendship confirmation)
      match /friends/{friendId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
        allow create, update, delete: if isAuthenticated() &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // ===============================================================
    // 5. Friend Requests (Validated Sender/Receiver & State Transitions)
    // ===============================================================
    match /friendRequests/{requestId} {
      // Only sender or receiver can read the request - prevents broad eavesdropping
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      // Sender can create, must not be self-request, initial status must be pending
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.fromUid != request.resource.data.toUid &&
        request.resource.data.status == 'pending';

      // Updates: ONLY intended recipient (toUid) can accept; either party can decline/cancel
      // Identities must remain strictly immutable
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.toUid || (request.auth.uid == resource.data.fromUid && request.resource.data.status == 'declined')) &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.status in ['pending', 'accepted', 'declined'];

      // Sender or receiver can cancel/delete
      allow delete: if isAuthenticated() &&
        (resource == null ||
         request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);
    }

    // ===============================================================
    // 6. Real-Time Online Presence
    // ===============================================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // ===============================================================
    // 7. Guilds (Hardened Least-Privilege Access)
    // ===============================================================
    match /guilds/{guildId} {
      allow read: if isAuthenticated();
      // Creator must be the designated leader
      allow create: if isAuthenticated() && request.resource.data.leaderUid == request.auth.uid;

      // Update: Guild leader can edit details; other authenticated members can only update memberCount during join/leave (+1/-1 only)
      allow update: if isAuthenticated() && (
        resource.data.leaderUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) &&
         (request.resource.data.memberCount == resource.data.memberCount + 1 ||
          request.resource.data.memberCount == resource.data.memberCount - 1))
      );

      // Delete: Strictly the guild leader
      allow delete: if isAuthenticated() && resource.data.leaderUid == request.auth.uid;

      // Guild Members Subcollection
      match /members/{memberUid} {
        allow read: if isAuthenticated();
        // A member can add themselves (join open guild only), or the leader can add
        allow create: if isAuthenticated() && (
          (request.auth.uid == memberUid && get(/databases/$(database)/documents/guilds/$(guildId)).data.joinType == 'open') ||
          isGuildLeader(guildId)
        );
        // Leader can update roles
        allow update: if isGuildLeader(guildId);
        // Member can leave (delete self), or leader can kick
        allow delete: if isAuthenticated() && (
          request.auth.uid == memberUid ||
          isGuildLeader(guildId)
        );
      }

      // Guild Join Requests Subcollection
      match /joinRequests/{requestUid} {
        allow read: if isAuthenticated() && (
          request.auth.uid == requestUid ||
          isGuildLeader(guildId)
        );
        // Requester creates their own join request
        allow create: if isAuthenticated() && request.auth.uid == requestUid;
        // Leader can update status (accept/reject)
        allow update: if isGuildLeader(guildId);
        // Requester can cancel or leader can clear
        allow delete: if isAuthenticated() && (
          request.auth.uid == requestUid ||
          isGuildLeader(guildId)
        );
      }
    }

    // ===============================================================
    // 8. Global Leaderboard Registry
    // ===============================================================
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || isGuildAffiliationUpdateOnly(userId);
    }

    // Default deny for all other unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
