rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hunter profile and private quest data
    match /hunters/{userId} {
      // Allow read if user is authenticated and is the owner
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow create and update only by the authenticated owner
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Prevent unauthorized deletion
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global Leaderboard Registry
    match /leaderboard/{userId} {
      // Public read for authenticated hunters
      allow read: if request.auth != null;
      
      // Write allowed only by the owner of the leaderboard record
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
